[Unit]
Description=focusd - focused-application detection daemon for Wayland
# 随图形会话启停：graphical-session.target 由桌面会话管理器在登录后拉起
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# 按安装路径调整；cargo 默认装到 ~/.cargo/bin
ExecStart=%h/.cargo/bin/focusd serve
# serve 的日志走 stderr（journald 收集），stdout 仅用于 CLI 人类输出
Environment=RUST_LOG=info
# Restart=on-failure 只是**兜底**（进程真崩了才拉起）；
# 不得用它掩盖逻辑缺陷——compositor 重启 / display 断开的**进程内自动重连**
# 才是正道（见 docs/dbus.md 连接中断语义），正常重连不应触发本 restart。
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
