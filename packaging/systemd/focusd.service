[Unit]
Description=focusd - focused-application detection daemon for Wayland
# 随图形会话启停：graphical-session.target 由桌面会话管理器在登录后拉起
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# 按安装路径调整；cargo 默认装到 ~/.cargo/bin
ExecStart=%h/.cargo/bin/focusd serve
# serve 的日志走 stderr（journald 收集），stdout 仅用于 CLI 人类输出
Environment=RUST_LOG=info
# Restart=on-failure 只是进程**崩溃**后的兜底，不是用来掩盖逻辑缺陷的：
# 连接中断 / compositor 重启应由进程内重连（T01–T04）自愈，
# 不应靠 systemd 反复拉起一个本可自愈的进程。
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
